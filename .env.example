# ============================================================
# DataContextOS Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Mode: "prod" (paid APIs) or "free" (zero-cost local/free-tier)
DCOS_MODE=free

# --- LLM Provider ---
# Options: "anthropic", "openai", "gemini", "ollama"
DCOS_LLM_PROVIDER=gemini
DCOS_LLM_MODEL=gemini-2.0-flash

# Anthropic (paid)
ANTHROPIC_API_KEY=
# OpenAI (paid)
OPENAI_API_KEY=
# Google Gemini (free tier)
GOOGLE_API_KEY=
# Ollama (local, free) — just run `ollama serve`
OLLAMA_BASE_URL=http://localhost:11434

# --- Embedding Provider ---
# Options: "openai", "huggingface"
DCOS_EMBEDDING_PROVIDER=huggingface
DCOS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector Store ---
# Options: "pgvector", "chroma"
DCOS_VECTOR_STORE=chroma
DCOS_CHROMA_PATH=./data/chroma_db

# --- Database ---
# Options: "postgresql", "sqlite"
DCOS_DATABASE=sqlite
DCOS_SQLITE_PATH=./data/datacontextos.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/datacontextos

# --- Reranker ---
# Options: "cohere", "cross-encoder", "none"
DCOS_RERANKER=cross-encoder
DCOS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COHERE_API_KEY=

# --- Tracing / Observability ---
# Options: "langsmith", "phoenix", "console", "none"
DCOS_TRACER=console
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=datacontextos

# --- Server ---
DCOS_API_HOST=0.0.0.0
DCOS_API_PORT=8000
DCOS_MCP_HOST=0.0.0.0
DCOS_MCP_PORT=8001

# --- Trust Score Thresholds ---
DCOS_TRUST_TRUSTED_THRESHOLD=0.8
DCOS_TRUST_REVIEW_THRESHOLD=0.6
DCOS_TRUST_CAUTION_THRESHOLD=0.4
